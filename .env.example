# Copy this file to .env and replace only the placeholder values.
# The real .env is ignored by git and must never be committed.

# DevNet Ledger API and update stream.
C8_BASE=https://api.validator.dev.digik.cantor8.tech/api/ledger
C8_WS_URL=wss://api.validator.dev.digik.cantor8.tech/api/ledger/v2/updates
C8_IDP=https://auth.dev.digik.cantor8.tech
C8_CLIENT_ID=hackathon
C8_CLIENT_SECRET=replace-me

# Optional explicit Canton user. When omitted, DevNet uses the JWT subject.
# C8_USER=validator-backend@clients

# Local scanner service. Keep this database between demo runs.
SCANNER_DB=scanner.db
SCANNER_RUN_WORKER=1
SCANNER_ADMIN_TOKEN=replace-with-a-long-random-local-token
SCANNER_MAX_PARTIES=50
